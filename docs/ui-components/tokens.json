{
  "$schema": "https://schemas.lawve.com/design-tokens/1.0.0",
  "$description": "Plaster UI Design Tokens (W3C Design Tokens Community Group draft format). CSS との同期方針: 手動更新。トークンを追加・変更する際は styles-light.css の :root と本ファイルの両方を更新する。",
  "$version": "1.3.0",
  "$lastUpdated": "2026-04-24",

  "color": {
    "base": {
      "bg-page":      { "value": "#E9F1F6", "type": "color", "$description": "ページ背景（Coastal）" },
      "bg-surface":   { "value": "#FFFFFF", "type": "color" },
      "bg-surface-2": { "value": "#F0EDE9", "type": "color" },
      "bg-surface-3": { "value": "#D3D0C8", "type": "color" },
      "bg-surface-neutral":     { "value": "#F5F5F5", "type": "color", "$description": "Phase D15-1 OB/WS データグリッド用ニュートラル surface" },
      "bg-surface-neutral-alt": { "value": "#F2F2F1", "type": "color", "$description": "Phase D15-1 OB/WS データグリッド ゼブラ用 neutral surface (alt)" },
      "bg-sidebar":   { "value": "#004554", "type": "color" },
      "divider":      { "value": "#B2D5E2", "type": "color" }
    },
    "day": {
      "sat":      { "value": "#EAF0F1", "type": "color", "$description": "Phase D15-1 土曜セル背景（WS/OB 共通）" },
      "sun":      { "value": "#F3ECEE", "type": "color", "$description": "Phase D15-1 日曜セル背景（WS/OB 共通）" },
      "sat-head": { "value": "#BECAC5", "type": "color", "$description": "Phase D15-1 土曜ヘッダ背景" },
      "sun-head": { "value": "#D4BEBD", "type": "color", "$description": "Phase D15-1 日曜ヘッダ背景" },
      "sat-cal":  { "value": "rgba(68, 166, 181, 0.06)", "type": "color", "$description": "Phase D15-1 土曜カレンダーオーバーレイ（teal 色相）" },
      "sun-cal":  { "value": "rgba(220, 120, 120, 0.06)", "type": "color", "$description": "Phase D15-1 日曜カレンダーオーバーレイ（warm rose 色相）" }
    },
    "text": {
      "primary":   { "value": "#004554", "type": "color" },
      "secondary": { "value": "#2A6B7A", "type": "color" },
      "tertiary":  { "value": "#5A8896", "type": "color", "$description": "Phase D6.1 で 4.6:1（WCAG AA）に改善" },
      "disabled":  { "value": "#8BAEB9", "type": "color", "$description": "Phase D6.1 で調整" }
    },
    "accent": {
      "primary":       { "value": "#44A6B5", "type": "color", "$description": "hsl(187, 46%, 50%)" },
      "primary-light": { "value": "#5AB8C6", "type": "color" },
      "primary-dim":   { "value": "rgba(68, 166, 181, 0.12)", "type": "color" },
      "secondary":       { "value": "#E07856", "type": "color", "$description": "Phase D5.1 第2アクセント（テラコッタ）" },
      "secondary-light": { "value": "#EA9980", "type": "color" },
      "secondary-dim":   { "value": "rgba(224, 120, 86, 0.12)", "type": "color" }
    },
    "semantic": {
      "success":      { "value": "#38A169", "type": "color" },
      "success-text": { "value": "#276749", "type": "color" },
      "warning":      { "value": "#D69E2E", "type": "color" },
      "warning-text": { "value": "#92400e", "type": "color" },
      "warning-bg":   { "value": "rgba(214, 158, 46, 0.1)", "type": "color" },
      "error":        { "value": "#DB577B", "type": "color" }
    },
    "category": {
      "facility-bg":   { "value": "rgba(68, 166, 181, 0.14)", "type": "color", "$description": "Phase D5.2 施設" },
      "facility-text": { "value": "#1c4d54", "type": "color" },
      "event-bg":      { "value": "rgba(122, 140, 196, 0.14)", "type": "color", "$description": "Phase D5.2 イベント" },
      "event-text":    { "value": "#2d3e7a", "type": "color" },
      "traffic-bg":    { "value": "rgba(180, 135, 100, 0.14)", "type": "color", "$description": "Phase D5.2 交通誘導" },
      "traffic-text":  { "value": "#5a3f25", "type": "color" },
      "highway-bg":    { "value": "rgba(98, 158, 120, 0.14)", "type": "color", "$description": "Phase D5.2 高速道路" },
      "highway-text":  { "value": "#1f4e31", "type": "color" }
    },
    "chart": {
      "categorical": {
        "1": { "value": "#44A6B5", "type": "color" },
        "2": { "value": "#E07856", "type": "color" },
        "3": { "value": "#7A8CC4", "type": "color" },
        "4": { "value": "#629E78", "type": "color" },
        "5": { "value": "#B48764", "type": "color" },
        "6": { "value": "#B8607A", "type": "color" }
      },
      "sequential": {
        "0": { "value": "#E9F1F6", "type": "color" },
        "1": { "value": "#B2D5E2", "type": "color" },
        "2": { "value": "#6B9AA8", "type": "color" },
        "3": { "value": "#2A6B7A", "type": "color" },
        "4": { "value": "#004554", "type": "color" }
      },
      "diverging": {
        "neg":     { "value": "#DB577B", "type": "color" },
        "neutral": { "value": "#D3D0C8", "type": "color" },
        "pos":     { "value": "#38A169", "type": "color" }
      }
    }
  },

  "typography": {
    "font-family": {
      "body": {
        "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic UI', 'Segoe UI', Roboto, sans-serif",
        "type": "fontFamily",
        "$description": "Phase D1.2 和文フォント対応"
      },
      "mono": {
        "value": "'SF Mono', Consolas, Menlo, monospace",
        "type": "fontFamily"
      }
    },
    "font-size": {
      "caption": { "value": "11px", "type": "dimension", "$description": "補助情報・ミニバッジ" },
      "sm":      { "value": "13px", "type": "dimension" },
      "base":    { "value": "14px", "type": "dimension", "$description": "本文標準" },
      "md":      { "value": "16px", "type": "dimension" },
      "lg":      { "value": "20px", "type": "dimension" },
      "xl":      { "value": "26px", "type": "dimension" },
      "2xl":     { "value": "34px", "type": "dimension" }
    },
    "font-weight": {
      "regular":  { "value": 400, "type": "fontWeight" },
      "medium":   { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold":     { "value": 700, "type": "fontWeight" },
      "black":    { "value": 800, "type": "fontWeight" }
    },
    "line-height": {
      "tight": { "value": 1.3, "type": "number" },
      "base":  { "value": 1.5, "type": "number" },
      "loose": { "value": 1.7, "type": "number" }
    }
  },

  "spacing": {
    "2xs": { "value": "2px",  "type": "dimension", "$description": "バッジ内縦padding専用の微小値" },
    "xs":  { "value": "4px",  "type": "dimension" },
    "sm":  { "value": "8px",  "type": "dimension" },
    "md":  { "value": "12px", "type": "dimension" },
    "lg":  { "value": "16px", "type": "dimension" },
    "xl":  { "value": "24px", "type": "dimension" },
    "2xl": { "value": "32px", "type": "dimension" },
    "3xl": { "value": "48px", "type": "dimension" }
  },

  "radius": {
    "sm": { "value": "4px",  "type": "dimension" },
    "md": { "value": "8px",  "type": "dimension" },
    "lg": { "value": "12px", "type": "dimension" },
    "xl": { "value": "16px", "type": "dimension" }
  },

  "elevation": {
    "0": { "value": "none", "type": "shadow" },
    "1": { "value": "0 1px 2px rgba(0,69,84,0.06)",  "type": "shadow" },
    "2": { "value": "0 2px 4px rgba(0,69,84,0.08)",  "type": "shadow" },
    "3": { "value": "0 4px 12px rgba(0,69,84,0.10)", "type": "shadow" },
    "4": { "value": "0 8px 24px rgba(0,69,84,0.14)", "type": "shadow" },
    "5": { "value": "0 16px 48px rgba(0,69,84,0.18)", "type": "shadow" }
  },

  "motion": {
    "duration": {
      "instant": { "value": "0ms",   "type": "duration" },
      "fast":    { "value": "120ms", "type": "duration" },
      "base":    { "value": "200ms", "type": "duration" },
      "slow":    { "value": "320ms", "type": "duration" },
      "slower":  { "value": "480ms", "type": "duration" }
    },
    "easing": {
      "out":    { "value": "cubic-bezier(0.16, 1, 0.3, 1)",    "type": "cubicBezier" },
      "in":     { "value": "cubic-bezier(0.7, 0, 0.84, 0)",    "type": "cubicBezier" },
      "in-out": { "value": "cubic-bezier(0.87, 0, 0.13, 1)",   "type": "cubicBezier" },
      "spring": { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "type": "cubicBezier" }
    }
  },

  "breakpoint": {
    "sm":  { "value": "640px",  "type": "dimension", "$description": "スマホ横" },
    "md":  { "value": "768px",  "type": "dimension", "$description": "タブレット縦" },
    "lg":  { "value": "1024px", "type": "dimension", "$description": "タブレット横・小型PC" },
    "xl":  { "value": "1280px", "type": "dimension", "$description": "デスクトップ" },
    "2xl": { "value": "1536px", "type": "dimension", "$description": "大画面" }
  },

  "icon-size": {
    "xs":  { "value": "12px", "type": "dimension" },
    "sm":  { "value": "14px", "type": "dimension" },
    "md":  { "value": "16px", "type": "dimension" },
    "lg":  { "value": "20px", "type": "dimension" },
    "xl":  { "value": "24px", "type": "dimension" },
    "2xl": { "value": "32px", "type": "dimension" }
  },

  "z-index": {
    "dropdown": { "value": 100,  "type": "number" },
    "sticky":   { "value": 200,  "type": "number" },
    "overlay":  { "value": 900,  "type": "number" },
    "modal":    { "value": 1000, "type": "number" },
    "popover":  { "value": 1100, "type": "number" },
    "tooltip":  { "value": 1200, "type": "number" },
    "toast":    { "value": 2000, "type": "number" }
  },

  "modal-width": {
    "sm": { "value": "380px", "type": "dimension" },
    "md": { "value": "480px", "type": "dimension" },
    "lg": { "value": "600px", "type": "dimension" },
    "xl": { "value": "800px", "type": "dimension" }
  },

  "density": {
    "compact": {
      "row-height":      { "value": "28px", "type": "dimension" },
      "space-row":       { "value": "4px",  "type": "dimension" },
      "fs-density-base": { "value": "13px", "type": "dimension" }
    },
    "comfortable": {
      "row-height":      { "value": "36px", "type": "dimension", "$description": "既定" },
      "space-row":       { "value": "8px",  "type": "dimension" },
      "fs-density-base": { "value": "14px", "type": "dimension" }
    },
    "spacious": {
      "row-height":      { "value": "44px", "type": "dimension" },
      "space-row":       { "value": "12px", "type": "dimension" },
      "fs-density-base": { "value": "15px", "type": "dimension" }
    }
  }
}
